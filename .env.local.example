# Copy this file to `.env.local` and fill in the two values from Google Cloud Console.
# BUILD_LOG.md step 1 walks through exactly where to get them.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match the redirect URI you entered in Google Cloud Console, character for character.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Only this Google account may connect. Single-user app.
ALLOWED_GOOGLE_EMAIL=you@example.com

# Signs the login cookie so a visitor cannot forge one. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Deployment only. Vercel's filesystem is read-only, so tokens and the saved
# spreadsheet id go to Redis instead of `.data/`. Leave both blank locally and
# the app keeps using the JSON files. Create a database at console.upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
